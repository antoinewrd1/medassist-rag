# Nothing here is required to run in offline mode.

# ---- Backends -------------------------------------------------------------
MA_LLM_BACKEND=fake            # fake | openai
MA_EMBED_BACKEND=local         # local | openai
MA_DB_URL=sqlite:///./medassist.db   # postgresql://postgres:pass@db:5432/medassist

# ---- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Retrieval ------------------------------------------------------------
MA_TOP_K=3
MA_MIN_SCORE=0.12              # below this, refuse rather than answer
